{
  "name": "pwa-apps",
  "private": true,
  "type": "module",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev:notes": "npm run dev -w @pwa-apps/notes",
    "dev:assets": "npm run dev -w @pwa-apps/assets",
    "dev:photo-layout": "npm run dev -w @pwa-apps/photo-layout",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.7.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vite-plugin-pwa": "^1.0.0"
  }
}
